{
  "name": "markdown-support",
  "displayName": "Markdown 支持",
  "version": "1.0.0",
  "description": "提供 Markdown 语法高亮和预览功能",
  "main": "./extension.js",
  "engines": {
    "noteStudio": "^1.0.0"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "extensions": [".md", ".markdown"],
        "aliases": ["Markdown"]
      }
    ],
    "commands": [
      {
        "command": "markdown.showPreview",
        "title": "Markdown: 打开预览"
      }
    ]
  }
}



