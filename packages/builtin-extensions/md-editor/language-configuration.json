{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "<", "close": ">", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "*", "close": "*", "notIn": ["string", "comment"] },
    { "open": "_", "close": "_", "notIn": ["string", "comment"] },
    { "open": "**", "close": "**", "notIn": ["string", "comment"] },
    { "open": "__", "close": "__", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["{", "}"],
    ["<", ">"],
    ["`", "`"],
    ["\"", "\""],
    ["'", "'"],
    ["*", "*"],
    ["_", "_"],
    ["**", "**"],
    ["__", "__"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#region\\b.*-->",
      "end": "^\\s*<!--\\s*#endregion\\b.*-->"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*- .*",
      "action": { "indentAction": "none", "appendText": "- " }
    },
    {
      "beforeText": "^\\s*\\* .*",
      "action": { "indentAction": "none", "appendText": "* " }
    },
    {
      "beforeText": "^\\s*\\+ .*",
      "action": { "indentAction": "none", "appendText": "+ " }
    },
    {
      "beforeText": "^\\s*\\d+\\. .*",
      "action": { "indentAction": "none", "appendText": "${capture}. " }
    },
    {
      "beforeText": "^\\s*- \\[ \\] .*",
      "action": { "indentAction": "none", "appendText": "- [ ] " }
    },
    {
      "beforeText": "^\\s*- \\[x\\] .*",
      "action": { "indentAction": "none", "appendText": "- [ ] " }
    },
    {
      "beforeText": "^\\s*> .*",
      "action": { "indentAction": "none", "appendText": "> " }
    }
  ]
}
