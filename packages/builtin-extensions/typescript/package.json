{
  "name": "typescript-support",
  "displayName": "TypeScript 支持",
  "version": "1.0.0",
  "description": "提供 TypeScript 语言支持",
  "main": "./extension.js",
  "engines": {
    "noteStudio": "^1.0.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "languages": [
      {
        "id": "typescript",
        "extensions": [".ts"],
        "aliases": ["TypeScript"]
      },
      {
        "id": "typescriptreact",
        "extensions": [".tsx"],
        "aliases": ["TypeScript React"]
      }
    ]
  }
}



