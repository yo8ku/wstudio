    "@note-studio/note-system": "workspace:*",
    "@note-studio/shared": "workspace:*",
    "@note-studio/theme": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "electron": "36.9.5",
    "electron-store": "^8.2.0",
    "iconv-lite": "^0.6.3",
    "jsonc-parser": "^3.3.1",
    "langchain": "^1.2.0",
    "node-pty": "npm:@homebridge/node-pty-prebuilt-multiarch@^0.13.1",
    "sql.js": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^9.0.0",
    "fast-check": "^3.15.0",
