{
  "name": "@note-studio/main",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.3",
    "@langchain/textsplitters": "^1.0.1",
    "@note-studio/extension-runtime": "workspace:*",
