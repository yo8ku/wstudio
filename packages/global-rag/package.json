{
  "name": "@note-studio/global-rag",
  "version": "1.0.0",
  "description": "Global RAG service with independent Python environment",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./python/bridge/PythonBridge": {
      "import": "./dist/python/bridge/PythonBridge.js",
      "types": "./dist/python/bridge/PythonBridge.d.ts"
    },
    "./vector-store/VectorStore": {
      "import": "./dist/vector-store/VectorStore.js",
      "types": "./dist/vector-store/VectorStore.d.ts"
    }
  },
  "scripts": {
    "build": "npx tsc",
    "dev": "npx tsc --watch",
    "setup:python": "node scripts/setup-python-env.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "rag",
    "vector-search",
    "embedding",
    "semantic-search",
    "global-service"
  ],
  "dependencies": {
    "@note-studio/theme": "workspace:*",
    "@note-studio/shared": "workspace:*",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  }
}


