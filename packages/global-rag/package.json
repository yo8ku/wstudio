{
  "name": "@note-studio/global-rag",
  "version": "1.0.0",
  "description": "Global RAG service with independent Python environment",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./python/bridge/PythonBridge": {
      "import": "./dist/esm/python/bridge/PythonBridge.js",
      "require": "./dist/cjs/python/bridge/PythonBridge.js",
      "types": "./dist/esm/python/bridge/PythonBridge.d.ts"
    },
    "./vector-store/VectorStore": {
      "import": "./dist/esm/vector-store/VectorStore.js",
      "require": "./dist/cjs/vector-store/VectorStore.js",
      "types": "./dist/esm/vector-store/VectorStore.d.ts"
    }
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.esm.json && npx tsc -p tsconfig.cjs.json",
    "build:esm": "npx tsc -p tsconfig.esm.json",
    "build:cjs": "npx tsc -p tsconfig.cjs.json",
    "dev": "npx tsc -p tsconfig.esm.json --watch",
    "setup:python": "node scripts/setup-python-env.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "rag",
    "vector-search",
    "embedding",
    "semantic-search",
    "global-service"
  ],
  "dependencies": {
    "@lancedb/lancedb": "^0.22.3",
    "@langchain/textsplitters": "^1.0.1",
    "@note-studio/shared": "workspace:*",
    "@note-studio/theme": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
