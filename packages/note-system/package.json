{
  "name": "@note-studio/note-system",
  "version": "1.0.0",
  "description": "Note system module for Note WStudio - types, parsers and utilities",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.esm.json && pnpm exec tsc -p tsconfig.cjs.json",
    "build:esm": "pnpm exec tsc -p tsconfig.esm.json",
    "build:cjs": "pnpm exec tsc -p tsconfig.cjs.json",
    "dev": "pnpm exec tsc -p tsconfig.esm.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "note",
    "markdown",
    "knowledge-graph",
    "backlinks",
    "tags",
    "parser"
  ],
  "dependencies": {
    "@note-studio/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.0.0",
    "vitest": "^1.2.0"
  }
}
