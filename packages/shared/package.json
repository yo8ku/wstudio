{
  "name": "@note-studio/shared",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./utils/workspaceSearchQuery": {
      "types": "./dist/cjs/utils/workspaceSearchQuery.d.ts",
      "require": "./dist/cjs/utils/workspaceSearchQuery.js",
      "import": "./dist/esm/utils/workspaceSearchQuery.js"
    }
  },
  "scripts": {
    "build": "pnpm build:cjs && pnpm build:esm",
    "build:cjs": "pnpm exec tsc --project tsconfig.cjs.json",
    "build:esm": "pnpm exec tsc --project tsconfig.esm.json && node scripts/fix-extensions.cjs",
    "dev": "pnpm exec tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
