{
  "name": "@note-studio/plugin",
  "version": "1.0.0",
  "description": "Note Studio plugin foundation package",
  "author": "WiseAI Team",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./internal/runtime": {
      "types": "./dist/cjs/internal/runtime.d.ts",
      "require": "./dist/cjs/internal/runtime.js",
      "import": "./dist/esm/internal/runtime.js"
    }
  },
  "keywords": [
    "wstudio",
    "plugin",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "pnpm exec tsc --project tsconfig.cjs.json",
    "build:esm": "pnpm exec tsc --project tsconfig.esm.json",
    "dev": "pnpm exec tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
