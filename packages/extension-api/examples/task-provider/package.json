{
  "name": "custom-task-provider",
  "displayName": "Custom Task Provider",
  "description": "Example task provider extension for Note Studio",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onTaskType:customTask"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "customTask",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "The script to run"
          },
          "args": {
            "type": "array",
            "description": "Additional arguments",
            "items": {
              "type": "string"
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "customTask.runTask",
        "title": "Custom Task: Run Task"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.18",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@note-studio/extension-api": "workspace:*"
  }
}



