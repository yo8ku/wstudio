{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client", "node"],
    "paths": {
      "@note-studio/extension-api": ["../../packages/extension-api/src/index.ts"]
    }
  },
  "include": ["host-src/**/*.ts", "webview-src/**/*.ts", "webview-src/**/*.tsx"]
}
