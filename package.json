{
  "name": "note-studio",
  "version": "1.0.0",
  "description": "Note WStudio - AI-powered note-taking application",
  "author": "WiseAI Team",
  "private": true,
  "main": "electron.js",
  "workspaces": [
    "packages/shared",
    "packages/extension-api",
    "packages/extension-runtime",
    "packages/theme",
    "packages/global-rag",
    "packages/note-system",
    "packages/main",
    "packages/renderer"
  ],
  "scripts": {
    "postinstall": "pnpm run rebuild:native",
    "dev": "concurrently \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite --config packages/renderer/vite.config.ts",
    "dev:electron": "wait-on http-get://127.0.0.1:5173/@vite/client && cross-env NODE_ENV=development electron .",
    "plugin:create": "node tools/scripts/create-extension.cjs",
    "plugin:validate": "pnpm --filter @note-studio/shared build && pnpm --filter @note-studio/extension-runtime build && node tools/scripts/validate-extension.cjs",
    "plugin:pack": "pnpm --filter @note-studio/shared build && pnpm --filter @note-studio/extension-runtime build && node tools/scripts/package-extension.cjs",
    "prebuild": "echo 'Prebuild step completed'",
    "rebuild:native": "node tools/scripts/rebuild-native-electron-deps.cjs",
    "build": "turbo run build",
    "build:electron": "pnpm run rebuild:native && pnpm run build && electron-builder --win --x64 --config.npmRebuild=false",
    "clean": "turbo run clean",
    "start": "electron ."
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "36.9.5",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^2.1.5",
    "sass-embedded": "^1.93.2",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.16.0",
    "better-sqlite3": "^11.10.0",
    "electron-store": "^8.2.0",
    "jsonc-parser": "^3.3.1",
    "mongodb": "^7.0.0",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "pg": "^8.16.3",
    "roughjs": "^4.6.6",
    "sharp": "0.32.6",
    "smart-buffer": "^4.2.0",
    "sql.js": "^1.12.0"
  }
}
