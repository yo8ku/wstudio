    "plugin:demo:ui-entry:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-ui-entry run typecheck",
    "plugin:demo:ui-entry:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-ui-entry run validate",
    "plugin:demo:command-notice-modal:build": "npm --prefix examples/plugins/wstudio-plugin-demo-command-notice-modal run build",
    "plugin:demo:command-notice-modal:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-command-notice-modal run typecheck",
    "plugin:demo:command-notice-modal:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-command-notice-modal run validate",
    "plugin:demo:settings-persistence:build": "npm --prefix examples/plugins/wstudio-plugin-demo-settings-persistence run build",
