{
  "name": "note-studio",
  "version": "1.0.0",
  "private": true,
  "main": "electron.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm exec cross-env NODE_ENV=development pnpm exec concurrently \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "pnpm exec vite --config packages/renderer/vite.config.ts",
    "dev:electron": "pnpm exec wait-on http://localhost:5173 && pnpm exec electron .",
    "build": "turbo run build",
    "build:electron": "electron-builder",
    "clean": "turbo run clean",
    "start": "electron .",
    "extension:install": "node scripts/install-extension.js",
    "extension:download": "node scripts/download-extensions.js",
    "test:extension": "node scripts/install-extension.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.6.0",
    "sass-embedded": "^1.93.2",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "electron": "^27.3.11",
    "electron-store": "^8.2.0"
  }
}
