{
  "name": "note-studio",
  "version": "1.0.0",
  "description": "Note WStudio - AI-powered note-taking application",
  "author": "WiseAI Team",
  "private": true,
  "main": "electron.js",
  "workspaces": [
    "packages/shared",
    "packages/theme",
    "packages/global-rag",
    "packages/note-system",
    "packages/plugin",
    "packages/main",
    "packages/renderer"
  ],
  "scripts": {
    "postinstall": "pnpm run rebuild:native",
    "dev": "concurrently \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:sample-plugin": "pnpm run plugin:sample:bootstrap && pnpm --filter @note-studio/main build && npm --prefix examples/plugins/wstudio-plugin-sample run build && cross-env WSTUDIO_PLUGIN_ROOTS=examples/plugins pnpm dev",
    "dev:renderer": "vite --config packages/renderer/vite.config.ts",
    "dev:electron": "wait-on http-get://127.0.0.1:5173/@vite/client && node tools/scripts/run-electron-dev.cjs",
    "plugin:sample:bootstrap": "node tools/scripts/bootstrap-plugin-sample.cjs",
    "plugin:sample:sync-sdk-package": "pnpm run plugin:sample:bootstrap",
    "plugin:sample:build": "npm --prefix ../wstudio-sample-plugin run build",
    "plugin:sample:typecheck": "npm --prefix ../wstudio-sample-plugin run typecheck",
    "plugin:sample:validate": "npm --prefix ../wstudio-sample-plugin run validate",
    "plugin:sample:smoke": "pnpm run plugin:sample:build && node tools/scripts/plugin-sample-smoke.cjs",
    "plugin:demo:lifecycle:build": "npm --prefix examples/plugins/wstudio-plugin-demo-lifecycle-basic run build",
    "plugin:demo:lifecycle:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-lifecycle-basic run typecheck",
    "plugin:demo:lifecycle:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-lifecycle-basic run validate",
    "plugin:demo:event-timer:build": "npm --prefix examples/plugins/wstudio-plugin-demo-global-event-timer run build",
