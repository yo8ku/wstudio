    "plugin:demo:editor-basic:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-editor-basic run validate",
    "plugin:demo:editor-suggest:build": "npm --prefix examples/plugins/wstudio-plugin-demo-editor-suggest run build",
    "plugin:demo:editor-suggest:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-editor-suggest run typecheck",
    "plugin:demo:editor-suggest:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-editor-suggest run validate",
    "plugin:demo:vault-file-ops:build": "npm --prefix examples/plugins/wstudio-plugin-demo-vault-file-ops run build",
