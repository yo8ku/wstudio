    "plugin:demo:vault-metadata-editor-combo:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-vault-metadata-editor-combo run validate",
    "plugin:demo:failure-reload:build": "npm --prefix examples/plugins/wstudio-plugin-demo-failure-reload run build",
    "plugin:demo:failure-reload:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-failure-reload run typecheck",
    "plugin:demo:failure-reload:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-failure-reload run validate",
    "plugin:demo:canvas-host:build": "npm --prefix examples/plugins/wstudio-plugin-demo-canvas-host run build",
    "plugin:demo:canvas-host:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-canvas-host run typecheck",
    "plugin:demo:canvas-host:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-canvas-host run validate",
    "plugin:api:inventory": "node tools/scripts/generate-plugin-api-inventory.cjs",
    "plugin:api:audit": "node tools/scripts/audit-plugin-api-compat.cjs",
    "plugin:api:runtime-smoke": "node tools/scripts/plugin-api-runtime-smoke.cjs",
    "plugin:api:test": "pnpm build && pnpm run plugin:api:audit && pnpm run plugin:api:runtime-smoke && pnpm run plugin:sample:smoke",
    "plugin:create": "node tools/scripts/create-extension.cjs",
    "plugin:validate": "node tools/scripts/validate-extension.cjs",
    "plugin:pack": "node tools/scripts/package-extension.cjs",
    "prebuild": "echo 'Prebuild step completed'",
    "rebuild:native": "node tools/scripts/rebuild-native-electron-deps.cjs",
    "build": "turbo run build",
    "build:electron": "pnpm run rebuild:native && pnpm run build && electron-builder --win --x64 --config.npmRebuild=false",
    "clean": "turbo run clean",
    "start": "electron ."
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "36.9.5",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^2.1.5",
    "sass-embedded": "^1.93.2",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.16.0",
    "better-sqlite3": "^11.10.0",
    "electron-store": "^8.2.0",
    "jsonc-parser": "^3.3.1",
    "mongodb": "^7.0.0",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "pg": "^8.16.3",
    "roughjs": "^4.6.6",
    "sharp": "0.32.6",
    "smart-buffer": "^4.2.0",
    "sql.js": "^1.12.0"
  }
