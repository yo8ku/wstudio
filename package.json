    "plugin:demo:vault-file-ops:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-vault-file-ops run validate",
    "plugin:demo:metadata-markdown:build": "npm --prefix examples/plugins/wstudio-plugin-demo-metadata-markdown run build",
    "plugin:demo:metadata-markdown:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-metadata-markdown run typecheck",
    "plugin:demo:metadata-markdown:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-metadata-markdown run validate",
    "plugin:demo:markdown-render:build": "npm --prefix examples/plugins/wstudio-plugin-demo-markdown-render run build",
    "plugin:demo:markdown-render:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-markdown-render run typecheck",
    "plugin:demo:markdown-render:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-markdown-render run validate",
    "plugin:demo:network-protocol:build": "npm --prefix examples/plugins/wstudio-plugin-demo-network-protocol run build",
    "plugin:demo:network-protocol:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-network-protocol run typecheck",
    "plugin:demo:network-protocol:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-network-protocol run validate",
    "plugin:demo:platform-utils:build": "npm --prefix examples/plugins/wstudio-plugin-demo-platform-utils run build",
    "plugin:demo:platform-utils:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-platform-utils run typecheck",
    "plugin:demo:platform-utils:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-platform-utils run validate",
    "plugin:demo:bases-overview:build": "npm --prefix examples/plugins/wstudio-plugin-demo-bases-overview run build",
    "plugin:demo:bases-overview:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-bases-overview run typecheck",
    "plugin:demo:bases-overview:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-bases-overview run validate",
    "plugin:demo:menu-context:build": "npm --prefix examples/plugins/wstudio-plugin-demo-menu-context run build",
    "plugin:demo:menu-context:typecheck": "npm --prefix examples/plugins/wstudio-plugin-demo-menu-context run typecheck",
    "plugin:demo:menu-context:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-menu-context run validate",
