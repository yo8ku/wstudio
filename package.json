    "plugin:demo:manifest-release-channel:validate": "npm --prefix examples/plugins/wstudio-plugin-demo-manifest-release-channel run validate",
    "plugin:demo:view-workspace:build": "npm --prefix \"examples/plugins/wstudio-plugin-demo-view-workspace ✅\" run build",
    "plugin:demo:view-workspace:typecheck": "npm --prefix \"examples/plugins/wstudio-plugin-demo-view-workspace ✅\" run typecheck",
    "plugin:demo:view-workspace:validate": "npm --prefix \"examples/plugins/wstudio-plugin-demo-view-workspace ✅\" run validate",
