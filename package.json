{
  "name": "note-studio",
  "version": "1.0.0",
  "description": "Note WStudio - AI-powered note-taking application",
  "author": "WiseAI Team",
  "private": true,
  "main": "electron.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite --config packages/renderer/vite.config.ts",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "prebuild": "echo 'Prebuild step completed'",
    "build": "turbo run build",
    "build:electron": "pnpm run build && electron-builder --win --x64 --config.npmRebuild=false",
    "clean": "turbo run clean",
    "start": "electron ."
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^27.3.11",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^2.1.5",
    "sass-embedded": "^1.93.2",
    "sharp": "^0.33.4",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "better-sqlite3": "^11.10.0",
    "electron-store": "^8.2.0",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.0.0",
    "smart-buffer": "^4.2.0",
    "sql.js": "^1.12.0"
  }
}
